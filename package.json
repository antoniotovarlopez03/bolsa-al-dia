{
  "name": "bolsa-al-dia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA gratuita para seguir las bolsas docentes de Andalucía (SIPRI). Herramienta independiente, no oficial.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "robot": "node robot/sipri.mjs",
    "test:robot": "node --test robot/procesar.test.mjs",
    "iconos": "node scripts/iconos.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
